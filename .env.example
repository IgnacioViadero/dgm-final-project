# Copia este fichero a .env y rellena lo que necesites. .env está en .gitignore.

# Token de Hugging Face (solo hace falta para modelos con acceso restringido)
HF_TOKEN=

# Dónde guardar los modelos descargados. En la DGX conviene apuntar a un disco compartido.
HF_HOME=./hf_cache

# Qué GPUs ve el proceso. En la DGX NO lo toquéis: SLURM lo fija a la partición que os asigna.
# Solo tiene sentido en una máquina propia con varias GPUs, por ejemplo "0" o "2,3".
# CUDA_VISIBLE_DEVICES=0

# Puerto de la API
ARCA_API_PORT=8000

# --- Cerebro compartido (agent_core/llm.py) --------------------------------------------
# Qué backend usa el LLM: "hf" (Qwen3-1.7B local, por defecto) o "endpoint"
# (servicio compatible con OpenAI).
ARCA_LLM_BACKEND=hf

# Modelo local cuando ARCA_LLM_BACKEND=hf
ARCA_MODEL=Qwen/Qwen3-1.7B

# Servicio central de la DGX cuando ARCA_LLM_BACKEND=endpoint.
# Solo accesible DENTRO de la DGX; la URL puede llevar o no el /v1 final.
ARCA_LLM_URL=http://0.0.0.0:8001
ARCA_LLM_MODEL=qwen3.8-27b-fp8
# SECRETO: la clave la dan los profesores. Pon su valor en tu .env (ignorado por git),
# nunca aquí ni en ningún otro fichero versionado.
ARCA_LLM_API_KEY=
# Timeout de cada petición, en segundos.
ARCA_LLM_TIMEOUT_S=300

# Trazas de razonamiento de Qwen (1/0, true/false). Vale para los dos backends.
# Por defecto DESACTIVADAS: cuestan tokens y latencia sin comprar exactitud. En el banco de
# los 90 el 27B saca 90/90 con y sin ellas, por ~300 tokens más y el doble de latencia; en el
# 1.7B el smoke acierta 8/8 sin thinking y 7/8 con él, al 50 % más de tokens (ver
# EXPERIMENTS.md, entradas del 20-11-2026).
ARCA_ENABLE_THINKING=0
